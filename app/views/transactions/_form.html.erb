<div id="<%= dom_id transaction %>" class="transaction-container">
<%= form_with(
  model: transaction,
  url: transaction.persisted? ? transaction_path(transaction) : transactions_path,
  method: transaction.persisted? ? :patch : :post,
  class: "transaction-row #{"transaction-new" if local_assigns[:new_transaction]}",
  data: { controller: "transaction-amounts", action: "input->transaction-amounts#toggleFields" }
) do |form| %>
  <div><%= form.date_field :date, aria: { label: "Date" } %></div>
  <div><%= form.text_field :number, aria: { label: "Number" }, placeholder: "Check #" %></div>
  <div><%= form.select :entity_id, options_for_select(@entities.map { |entity| [ "#{entity.name} (#{entity.entity_type})", entity.id, { data: { display_name: entity.name } } ] }, transaction.entity_id), { prompt: "Choose payee" }, required: true, aria: { label: "Payee" }, data: { controller: "entity-select", entity_select_target: "select", action: "focus->entity-select#showTypes blur->entity-select#hideSelectedType change->entity-select#hideSelectedType" } %></div>
  <div class="transaction-amount-field payment-field"><span class="currency-prefix">$</span><%= form.text_field :payment, value: (transaction.payment.to_d.zero? ? "" : number_to_currency(transaction.payment, unit: "", format: "%n", delimiter: ",")), inputmode: "decimal", data: { transaction_amounts_target: "payment" }, aria: { label: "Payment" } %></div>
  <div class="transaction-amount-field deposit-field"><span class="currency-prefix">$</span><%= form.text_field :deposit, value: (transaction.deposit.to_d.zero? ? "" : number_to_currency(transaction.deposit, unit: "", format: "%n", delimiter: ",")), inputmode: "decimal", data: { transaction_amounts_target: "deposit" }, aria: { label: "Deposit" } %></div>
  <div class="transaction-balance"><%= number_to_currency(transaction.balance) %></div>
  <%= form.hidden_field :account_id %>
  <div class="transaction-category"><%= form.select :category_account_id, options_from_collection_for_select(@accounts, :id, ->(account) { "#{account.number} — #{account.name}" }, transaction.category_account_id), { include_blank: "Choose account" }, required: true, aria: { label: "Account" } %></div>
  <div class="row-action"><%= form.submit transaction.persisted? ? "Save" : "Add", class: "text-link" %></div>
  <div class="transaction-memo"><%= form.text_field :memo, aria: { label: "Memo" }, placeholder: "Memo" %></div>
<% end %>
</div>
